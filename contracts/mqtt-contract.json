{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "topicRoot": "pcbot/v1/{deviceId}",
  "topics": {
    "powerCommand": "command/power",
    "speedTestCommand": "command/speedtest",
    "resetCommand": "command/reset",
    "volumeCommand": "command/volume",
    "pcState": "state/pc",
    "botState": "state/bot",
    "speedTestState": "state/speedtest",
    "mediaState": "state/media",
    "volumeState": "state/volume",
    "telemetry": "telemetry/system",
    "alert": "event/alert",
    "ack": "event/ack"
  },
  "command": {
    "required": ["commandId", "source", "action", "issuedAt", "expiresAt"],
    "sources": ["mobile", "home-assistant", "google-home", "bot", "tray"],
    "actions": ["on", "off", "toggle", "run", "wifi", "factory"]
  },
  "telemetry": {
    "required": ["timestamp", "cpu", "gpu", "memory", "storage", "network", "uptimeSeconds"]
  },
  "media": {
    "required": ["status", "title", "artist", "album", "app", "timestamp"],
    "statuses": ["playing", "paused", "stopped"],
    "retained": true,
    "note": "Published by the tray app from the Windows media session. positionSeconds and durationSeconds are optional; players that do not report a timeline omit them."
  },
  "volume": {
    "state": {
      "required": ["level", "muted", "timestamp"],
      "retained": true
    },
    "setpoint": {
      "required": ["level", "source", "timestamp"],
      "qos": 0,
      "retained": false,
      "note": "Absolute 0-100 master volume from the bot's knob. Deliberately not a command envelope: it is continuous state, so a late value is worthless rather than worth retrying."
    }
  },
  "defaults": {
    "commandTtlSeconds": 30,
    "telemetryIntervalSeconds": 5,
    "telemetryLossSeconds": 30,
    "alertSustainSeconds": 15,
    "alertCooldownSeconds": 300,
    "idleSleepSeconds": 60,
    "thresholds": {
      "cpuTempC": 90,
      "gpuTempC": 88,
      "driveTempC": 70,
      "memoryUsedPercent": 95,
      "driveFreePercent": 10,
      "hysteresis": 5
    }
  }
}

